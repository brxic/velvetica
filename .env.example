# Optional. When omitted, Velvetia uses the local preview routing provider.
ROUTING_PROVIDER=preview
VALHALLA_URL=http://localhost:8002
# Optional fallback when a configured Valhalla instance is unavailable.
ROUTING_FALLBACK=preview
DATABASE_URL=postgresql://velvetia:velvetia-local-only@localhost:5432/velvetia
REDIS_URL=redis://localhost:6379
