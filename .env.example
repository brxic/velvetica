# valhalla for local/self-hosted routing, fossgis for the rate-limited public OSM bicycle fallback.
ROUTING_PROVIDER=preview
VALHALLA_URL=http://localhost:8002
FOSSGIS_URL=https://routing.openstreetmap.de/routed-bike
# Optional fallback when a configured Valhalla instance is unavailable.
ROUTING_FALLBACK=preview
DATABASE_URL=postgresql://velvetia:velvetia-local-only@localhost:5432/velvetia
REDIS_URL=redis://localhost:6379

# Optional Supabase cloud sync and email/password authentication.
# The publishable key is intentionally browser-safe; never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
